# Copy to terraform.tfvars (gitignored) and fill the real values.
# Single managed environment — this file is the whole deployment.
#
# CI reads this SAME file, not a separate copy: after any edit to the real
# terraform.tfvars, push the whole file to the one GitHub secret CI writes
# back out before every plan/apply —
#   gh secret set TF_VARS_FILE < terraform.tfvars
# There is no second place to keep in sync. Forgetting this step is the
# single most common way local and CI Terraform state diverge — it silently
# destroyed two IAM bindings once already (2026-09-02) when a new variable
# was added locally but never pushed to the CI secret.
#
# Prereq: run `just deploy bootstrap-state` once (creates the GCS state bucket
# and writes terraform/backend.tfbackend). Without it, `terraform init` has no
# backend and `just tf-plan` will fail.
#
# Standard pattern: {project}-{environment}-tfstate (e.g. cv-rest-mcp-server-production-tfstate).
# Currently production-only; add dev/stage/qa prefixes when those envs are added.
# Example: cv-rest-mcp-server-dev-tfstate, cv-rest-mcp-server-stage-tfstate, cv-rest-mcp-server-qa-tfstate
# This naming convention helps with multi-environment management and CI/CD pipelines.
# When adding new environments, update both the state bucket name and the
# corresponding service account emails in the services block.

project_id = "cv-rest-mcp-server"
region     = "europe-west1"

# Real apex domain (register + verify first; see .local/custom-domain-plan.md).
apex_domain = "example.com"
# dns_name = "example.com."   # default: derived from apex_domain
create_dns_zone = true
# subdomains = ["@", "www", "api", "app", "games"]

# Distinct Cloud Run workloads. Service account emails follow the existing
# <svc>-runtime@<project>.iam.gserviceaccount.com convention (created by
# scripts/deploy-cloud-run.sh wif/bootstrap before Phase 1a).
#
# Image tagging strategy:
#   - deploy-app.yml (app code changes) tags every image with commit SHA
#     (SHORT_SHA) for traceability, also tags :latest for convenience, and
#     releases via `gcloud run deploy --image <SHA tag>` — no Terraform apply.
#   - ci-cd.yaml (terraform/** changes only) applies this `services` map as-is;
#     the `image` field below is only the fallback for a from-scratch apply
#     (each Cloud Run service ignores drift on its image field afterwards —
#     see modules/cloud_run_service lifecycle.ignore_changes).
#   - For manual terraform apply: override with -var flag if deploying an older SHA
services = {
  api-core = {
    image                 = "europe-west1-docker.pkg.dev/cv-rest-mcp-server/cv-images/api-core:latest"
    service_account       = "api-core-runtime@cv-rest-mcp-server.iam.gserviceaccount.com"
    allow_unauthenticated = true
    env_vars = {
      # Gates settings.environment == "production" checks — e.g. the
      # __Host-refresh_token cookie's Secure flag (auth/routes.py). Missing
      # this silently defaults to "development" and breaks that cookie in
      # prod (browser rejects SameSite=None without Secure).
      ENVIRONMENT          = "production"
      TRUST_PROXY          = "true"
      CLIENT_IP_XFF_ENTRY  = "2"
      BLOCKED_IPS_FILE     = "config/blocked_geo.txt"
      FAILBAN_THRESHOLD    = "6"
      CV_DATA_GCS_URI      = "gs://cv-rest-mcp-server-cv-data/cv.json"
      CV_REFRESH_SECONDS   = "30"
      # Phase-1c: CORS pinned to the SPA origin. Only the refresh endpoint
      # (`/api/v1/auth/refresh`) sets `Access-Control-Allow-Credentials: true`;
      # every other CORS response is credential-less. Update when the apex
      # domain changes — keep aligned with app.<apex> from host_routing.
      CORS_ORIGIN          = "https://app.example.com"
      GAMES_BASE_URL       = "https://games.example.com"
      FIRST_ADMIN_USERNAME       = "CHANGEME-pick-a-non-obvious-name"
      FIRST_ADMIN_EMAIL       = "admin@example.com"
    }
    # Phase-1c: HS256 issuer (single shared secret). Secret in Secret Manager;
    # version is "latest" for now (rotate by re-uploading + bumping below).
    # secrets = {
    #   JWT_SIGNING_KEY      = { secret_id = "cv-jwt-signing-key", version = "latest" }
    #   REFRESH_TOKEN_PEPPER = { secret_id = "cv-refresh-token-pepper", version = "latest" }
    #   FIRST_ADMIN_PASSWORD = { secret_id = "cv-first-admin-password", version = "latest" }
    # }
    max_instances = 1
    memory        = "512Mi"
  }
  api-games = {
    image                 = "europe-west1-docker.pkg.dev/cv-rest-mcp-server/cv-images/api-games:latest"
    service_account       = "api-games-runtime@cv-rest-mcp-server.iam.gserviceaccount.com"
    allow_unauthenticated = true
    env_vars = {
      # "Back to portfolio" needs an absolute URL — games runs as a separate
      # Cloud Run service from the apex/api-core host.
      PORTFOLIO_BASE_URL = "https://example.com"
    }
    max_instances = 1
  }
  spa-origin = {
    image                 = "europe-west1-docker.pkg.dev/cv-rest-mcp-server/cv-images/spa-origin:latest"
    service_account       = "spa-origin-runtime@cv-rest-mcp-server.iam.gserviceaccount.com"
    allow_unauthenticated = true
    max_instances         = 1
  }
  # workers = {
  #   image                 = "europe-west1-docker.pkg.dev/cv-rest-mcp-server/cv-images/workers:latest"
  #   service_account       = "workers-runtime@cv-rest-mcp-server.iam.gserviceaccount.com"
  #   allow_unauthenticated = false   # private: invoked via Pub/Sub/Cloud Tasks, never public
  #   max_instances         = 1
  # }
}

# hostname -> workload name. GCP URL-map host rules match EXACTLY (no wildcard
# propagation): the bare apex and www are separate rules, and both route to
# api-core (Jinja landing + /cv*). Add the bare apex here too if you want
# https://<apex> to work without the www prefix — the DNS side already resolves
# it via the subdomains "@" entry.
host_routing = {
  "example.com"       = "api-core"   # bare apex -> landing (no www prefix)
  "www.example.com"   = "api-core"
  "api.example.com"   = "api-core"
  "app.example.com"   = "spa-origin"
  "games.example.com" = "api-games"
}

# --- Cloud CDN static-asset serving (optional) ---
# Creates the GCS bucket (public-read origin), enables Cloud CDN, and prefixes
# <host><prefix> (e.g. https://app.example.com/assets/*) to the CDN bucket while
# <host>/ stays on the spa-origin container. `host` must already be in
# host_routing. Assets are usually loaded by index.html with asset URLs pointing
# at this origin. See docs/cloud-cdn.md for how it works.
# Vite hashes frontend/dist/assets/* filenames, so use long cache TTL (immutable).
static_assets = {
  enabled      = true
  bucket_name  = "myproj-static"
  location     = "EU"
  host         = "app.example.com"
  prefix       = "/assets/"
  cors_origins = ["https://app.example.com"]
}

# --- GitHub Workload Identity Federation (CI/CD) ---
# One-time setup: creates the WIF pool, OIDC provider, and IAM bindings.
# After applying, run: terraform output | grep github_wif_provider
# Then add these as GitHub repository secrets:
#   GCP_WIF_PROVIDER = <github_wif_provider output>
#   GCP_DEPLOY_SA    = <deployer_sa_email output>
setup_github_wif = true
github_repo      = "ivanprytula/cv-rest-mcp-server"  # your GitHub repo in owner/repo format

# --- Organization Policies (Security Guardrails) ---
# Optional: enforce bucket security policies at the project level (runtime defense-in-depth).
# Also run the pre-commit guard (scripts/ensure_deny_public.py) in CI/CD for static validation.
# NOTE: Terraform will auto-enable cloudresourcemanager.googleapis.com (no manual step needed).
setup_org_policies = true

# --- Cloud Armor (DDoS/Abuse Protection) ---
# Optional: protect static CDN assets from rate-abuse and DDoS attacks via edge firewall.
# Attached to load balancer; blocks traffic before it hits Cloud CDN or origin.
# NOT a bucket-level policy — provides edge-layer rate limiting and filtering.
# Default: 100 req/IP per 60s (adjust for your traffic patterns; increase for legitimate high-traffic).
enable_cloud_armor                  = false
cloud_armor_rate_limit_count        = 100
cloud_armor_rate_limit_interval_sec = 60

# --- Cloud SQL Postgres (ADR-023 Phase 2 — auth/user store) ---
# Infra-only in this PR: no service reads DATABASE_URL yet (that's the next
# PR). db-f1-micro/zonal/no-HA, ~$9/month per Infracost. Password secret
# (cv-db-password) is script-owned — run `just deploy bootstrap-secrets`
# before the first `terraform apply` with this set to true.
enable_cloud_sql = false
# cloud_sql_db_password_secret_id = "cv-db-password"  # default shown; override only if renamed

# --- Bootstrap (one-time setup before terraform apply) ---
# Use deploy-cloud-run.sh for first-time setup:
#   just deploy bootstrap          # enable APIs (now also via Terraform gcp_apis module)
#   just deploy bootstrap-state    # create TF remote state bucket
#   just deploy bootstrap-secrets  # create Secret Manager secrets
# Then: terraform apply (applies iam_secrets, org_policies, cloud run services, etc.)
# The CV bucket (gs://cv-rest-mcp-server-cv-data) is created manually by bootstrap and
# managed separately from Terraform (it is application data, not infrastructure).

# --- Private user-content upload bucket (optional, currently DISABLED) ---
# Avatars/photos for auth-protected APIs. Deny-public enforced, no CDN; the UI
# uploads exclusively via server-generated V4 signed URLs. app_sa = the app
# service account email.
# Keep this commented together with module "uploads" in main.tf until ready.
# uploads = {
#   bucket_name    = "myproj-uploads"
#   location       = "EU"
#   app_sa         = "api-core-sa@myproj.iam.gserviceaccount.com"
#   write_prefixes = ["avatars/", "photos/"]
# }
