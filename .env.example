# cv-rest-mcp-server configuration
#
# Copy to `.env` and adjust. Pydantic Settings ingests these with no prefix;
# every variable is optional — empty/unset means "use app/settings.py defaults"
# (FAILBAN_* below shows recommended production values, not code defaults).
# None of these are secrets. `.env` is gitignored; this file is not.

# --- Core ---
# Path to the CV JSON file validated against CVData (local/dev mode).
CV_DATA_PATH=data/cv.json
# Production CV delivery: private GCS object. The image ships only the
# cv.example.json placeholder; when this is set, the app boots on it until
# a real cv.json appears in the bucket, then hot-reloads on change.
# Upload updates with: just deploy upload-cv   (requires bucket + runtime SA access)
CV_DATA_GCS_URI=
# How often (seconds) the GCS object generation is re-checked. 0 = every request.
CV_REFRESH_SECONDS=30
# Server port (Cloud Run injects PORT automatically).
PORT=8080

# --- OpenAPI / Swagger UI metadata (/docs) ---
# Shown in the Swagger UI header as the API contact. Empty = omitted.
CONTACT_NAME=
CONTACT_EMAIL=

# --- Client-IP strategy for rate limiting behind a proxy ---
# Take the Nth entry of X-Forwarded-For counted from the RIGHT.
# Cloud Run recipe: 2 (GFE appends itself, so the penultimate entry is the
# real client and cannot be spoofed without controlling a hop adjacent to GFE).
# --- Client-IP strategy (rate limits, bans, allow/block lists) ---
# Cloud Run: the sandbox proxy presents 127.0.0.1 as socket peer for every
# request, so you MUST set both of these there or limits/bans silently stop
# applying (loopback exemption + shared key):
TRUST_PROXY=false
CLIENT_IP_XFF_ENTRY=2
# Alternative: raw single-value header set by a trusted proxy (nginx recipe:
# X-Real-IP). Ignored when CLIENT_IP_XFF_ENTRY > 0 and that header is present.
# Empty string = use the socket peer address.
CLIENT_IP_HEADER=

# --- Static access lists (comma-separated IPs/CIDRs) ---
# Denied clients get 403 before any rate limiting.
BLOCKED_IPS=
# Whitelist mode: when set, ONLY listed clients may connect (others get 403).
ALLOWED_IPS=
# File variants: one IP/CIDR per line, '#' comments allowed; merged with the
# inline value. Large lists (e.g. country blocks) MUST use the file form —
# env vars are capped at ~128KB by the OS. See config/blocked_geo.txt
# (refresh with `just update-geo-blocklist`), then set:
BLOCKED_IPS_FILE=config/blocked_geo.txt
ALLOWED_IPS_FILE=

# --- Scheduled availability window ---
# Evaluated in SERVICE_TIMEZONE (IANA name, default UTC).
# Empty start/end = always open. Overnight windows (start > end) supported.
SERVICE_HOURS_START=
SERVICE_HOURS_END=
# Comma-separated weekday names (mon,tue,wed,thu,fri,sat,sun). Only applies
# when hours are configured. Empty = every day. Closed hours return 503.
SERVICE_DAYS=
SERVICE_TIMEZONE=UTC

# --- Dynamic bans (fail2ban-lite) ---
# N rate-limit violations (REST 429 or MCP ToolError) within WINDOW seconds
# triggers a BAN_SECONDS temporary ban for the offending client.
# Code default: threshold=0 (disabled). Loopback is never banned; in-memory,
# single-process state.
FAILBAN_THRESHOLD=6
FAILBAN_WINDOW_SECONDS=900
FAILBAN_BAN_SECONDS=1800
FAILBAN_MAX_TRACKED=10000

# --- Bearer-token auth for POST /cv/tailor ---
# Single-operator. Enforced by TailorAuthMiddleware; does NOT affect any
# other route. Fail-closed: when neither is set, /cv/tailor returns 503.
#
# Production: Managed via Google Secret Manager and injected by Cloud Run.
# Local development: Set the inline value (TAILOR_BEARER_TOKEN) or use a
# file path (TAILOR_BEARER_TOKEN_FILE).
TAILOR_BEARER_TOKEN=
TAILOR_BEARER_TOKEN_FILE=

# --- Phase-1c auth (Bearer+CORS+HS256) ---
# Production: Secrets stored in Google Secret Manager and injected by Cloud Run:
# - JWT_SIGNING_KEY (shared HS256 secret)
# - REFRESH_TOKEN_PEPPER (string)
#
 # Local development: Set these as environment variables in your .env file.
 #   JWT_SIGNING_KEY is the single shared HS256 secret (symmetric JWT — api-core
 #   signs and validates with the same value, and it's replicated to any service
 #   that must validate tokens; see ADR-022). A plain random string works, no PEM
 #   key. Generate one plus REFRESH_TOKEN_PEPPER with:
 #     uv run python scripts/gen_secrets.py
 JWT_SIGNING_KEY=
 REFRESH_TOKEN_PEPPER=
 #
 # JWT audience for api-core (used by other services to validate).
 JWT_AUDIENCE=cv-rest-mcp-server
 # JWT issuer for api-core (used by other services to validate).
 JWT_ISSUER=https://api.example.com
 # CORS pinned to the SPA origin for the single credentialed-CORS endpoint
 # (`/api/v1/auth/refresh`). Other CORS responses are credential-less.
 CORS_ORIGIN=https://app.example.com
 #
 # --- Phase-1d user store (SQLAlchemy async + aiosqlite, ADR-022) ---
 # Users live in a SQLite DB (user_db_path) seeded at startup with a first admin
 # when FIRST_ADMIN_PASSWORD is set (idempotent). Login is fail-closed: with no
 # seeded user, /api/v1/auth/token returns a generic 401. Only the first admin
 # is password-seeded via env; further users are an operator/SQL migration.
 USER_DB_PATH=data/cv_auth.db
 FIRST_ADMIN_USERNAME=operator
 FIRST_ADMIN_EMAIL=operator@example.com
 # Plaintext password for the first admin (a real secret). Production: inject as
 # a mounted file (FIRST_ADMIN_PASSWORD_FILE) from Secret Manager.
 FIRST_ADMIN_PASSWORD=
 FIRST_ADMIN_PASSWORD_FILE=
 #
 # Access token lifetime (minutes) and refresh token lifetime (days). The
 # refresh token rotates on every use with family reuse-detection.
ACCESS_TOKEN_TTL_MINUTES=10
REFRESH_TOKEN_TTL_DAYS=30

# --- Skill bank + tailored revisions (POST /cv/tailor, MCP match_jd) ---
# The bank is a SEPARATE matching source from the live CV (see data/cv_baseline.json).
# Lazy-loaded on first use and memoized per file mtime; editing the file while the
# server runs picks up the change on the next /cv/tailor call.
CV_BASELINE_PATH=data/cv_baseline.json
# Subfolder that receives cv_tailored-<UTC-timestamp>.json revision files. The
# operator promotes a revision to the public CV, never auto-overwrites it.
CV_TAILORED_DIR=data/tailored

# --- Cloud Run deploy (consumed by scripts/deploy-cloud-run.sh via `set dotenv-load`,
#     ignored by the app itself). Repo keeps its own name; this names the DEPLOYED
#     service, image tag and -runtime/-deployer service accounts after you —
#     better for a recruiter-facing URL. Changing it deploys alongside the old
#     service; delete the old one once the new URL is live.
# Must match a key in terraform.tfvars `services` (e.g. "api-core") so that
# `just tf-apply` and `scripts/deploy-cloud-run.sh` stay in sync.
SVC_NAME=
