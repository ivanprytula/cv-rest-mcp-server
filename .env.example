# Copy to `.env` and adjust. Pydantic Settings ingests these with no prefix;
# every variable is optional — empty/unset means "use app/settings.py defaults"
# (FAILBAN_* below shows recommended production values, not code defaults).
# None of these are secrets. `.env` is gitignored; this file is not.

# --- Core ---
# Path to the CV JSON file validated against CVData (local/dev mode).
CV_DATA_PATH=data/cv.json
# Production CV delivery: private GCS object. The image ships only the
# cv.example.json placeholder; when this is set, the app boots on it until
# a real cv.json appears in the bucket, then hot-reloads on change.
# Upload updates with: just deploy upload-cv   (requires bucket + runtime SA access)
CV_DATA_GCS_URI=
# How often (seconds) the GCS object generation is re-checked. 0 = every request.
CV_REFRESH_SECONDS=30
# Server port (Cloud Run injects PORT automatically).
PORT=8080
ENVIRONMENT=development

# --- OpenAPI / Swagger UI metadata (/docs) ---
# Shown in the Swagger UI header as the API contact. Empty = omitted.
CONTACT_NAME=
CONTACT_EMAIL=

# --- Client-IP strategy (rate limits, bans, allow/block lists) ---
# Determines the source IP used for rate limiting and access control.
# TRUST_PROXY: Set to true on platforms where the socket peer is a local proxy hop
#   rather than the client (e.g., Cloud Run sees 127.0.0.1 for every request).
#   Disables loopback-peer exemptions so rate limits and failban stay effective.
TRUST_PROXY=false
#
# CLIENT_IP_XFF_ENTRY: Take the Nth entry of X-Forwarded-For counted from the RIGHT.
#   Cloud Run recipe: 2 — GFE appends itself, so the penultimate entry is the real
#   client and cannot be spoofed without controlling a hop adjacent to GFE.
#   Set to 0 to disable X-Forwarded-For parsing.
CLIENT_IP_XFF_ENTRY=2
#
# CLIENT_IP_HEADER: Alternative to X-Forwarded-For; a raw single-value header set
#   by a trusted proxy (nginx recipe: X-Real-IP). Ignored when CLIENT_IP_XFF_ENTRY > 0
#   and that header is present. Empty = use socket peer address.
CLIENT_IP_HEADER=

# --- Static access lists (comma-separated IPs/CIDRs) ---
# BLOCKED_IPS: Denied clients get 403 before any rate limiting.
BLOCKED_IPS=
# ALLOWED_IPS: Whitelist mode; when set, ONLY listed clients may connect (others 403).
ALLOWED_IPS=
# *_FILE variants: Path to text file, one IP/CIDR per line ('#' comments allowed).
#   Merged with the inline value. Large lists (e.g., country blocks) MUST use the
#   file form (env vars are capped at ~128KB by execve). See config/blocked_geo.txt
#   (refresh with `just update-geo-blocklist`):
BLOCKED_IPS_FILE=config/blocked_geo.txt
ALLOWED_IPS_FILE=

# --- Scheduled availability window ---
# SERVICE_HOURS_START/END: HH:MM format (24-hour). Evaluated in SERVICE_TIMEZONE.
#   Empty start/end = always open. Overnight windows (start > end) supported.
#   Outside window: returns 503 (service unavailable).
SERVICE_HOURS_START=
SERVICE_HOURS_END=
#
# SERVICE_DAYS: Comma-separated weekday names (mon,tue,wed,thu,fri,sat,sun).
#   Only applies when hours are configured. Empty = every day.
SERVICE_DAYS=
#
# SERVICE_TIMEZONE: IANA timezone name (e.g., UTC, Europe/Berlin). Default: UTC.
SERVICE_TIMEZONE=UTC

# --- Dynamic bans (fail2ban-lite) ---
# N rate-limit violations (REST 429 or MCP ToolError) within WINDOW seconds
# triggers a BAN_SECONDS temporary ban for the offending client.
# Code default: threshold=0 (disabled). Loopback is never banned; in-memory,
# single-process state.
FAILBAN_THRESHOLD=6
FAILBAN_WINDOW_SECONDS=900
FAILBAN_BAN_SECONDS=1800
FAILBAN_MAX_TRACKED=10000

# --- Phase-1c auth (Bearer+CORS+HS256) ---
# JWT_SIGNING_KEY: The single shared HS256 secret (symmetric JWT). api-core signs
#   and validates with it, and every microservice that must validate a token is
#   given the same value (deliberate HS256 choice for easy horizontal scaling of
#   stateless services — a plain random string, no PEM key management).
#   Production: Stored in Google Secret Manager (terraform/modules/iam_secrets) and
#     injected as an env var by Cloud Run via secret_key_ref. Terraform wires:
#     JWT_SIGNING_KEY -> cv-jwt-signing-key:latest
#   Local dev: Generate with `uv run python scripts/gen_secrets.py`
#   Fail-closed: when unset, auth 503s.
JWT_SIGNING_KEY=
#
# REFRESH_TOKEN_PEPPER: Additional entropy for refresh token generation (rotating
#   token family). Same deployment strategy as JWT_SIGNING_KEY.
#   Production: Stored in Secret Manager (cv-refresh-token-pepper:latest)
#   Local dev: Generate with `uv run python scripts/gen_secrets.py`
REFRESH_TOKEN_PEPPER=
#
# JWT_AUDIENCE: Claim value stamped on issued tokens and checked on verify.
#   api-core is the issuer and (for the interim slice) its only verifier; any
#   service that must validate later is handed the same JWT_SIGNING_KEY.
JWT_AUDIENCE=cv-rest-mcp-server
#
# JWT_ISSUER: Claim value stamped on issued tokens and checked on verify.
JWT_ISSUER=https://api.example.com
#
# CORS_ORIGIN: Pinned SPA origin for the single credentialed-CORS endpoint
#   (/api/v1/auth/refresh). Other CORS responses are credential-less.
#   In production, set to https://app.<your-apex-domain> (matches host_routing).
CORS_ORIGIN=https://app.example.com
#
# GAMES_BASE_URL: Absolute base URL of the games workload, used by the landing
#   page to link to /culture-bingo. The games app is a SEPARATE service — it is
#   not mounted in api-core — so a relative link 404s in both dev and prod.
#   Local:      http://localhost:8081   (services/games runs on 8081)
#   Production: https://games.<your-apex-domain>
#   No trailing slash. Empty renders a relative link, which only works if you
#   ever mount the games router into this app.
GAMES_BASE_URL=http://localhost:8081
 #
# --- Phase-1d user store (SQLAlchemy async + aiosqlite) ---
# USER_DB_PATH: Path to SQLite user database (Phase 2+ swaps to asyncpg/Postgres).
#   Fail-closed: missing db with configured FIRST_ADMIN_* is a startup error.
USER_DB_PATH=data/cv_auth.db
#
# FIRST_ADMIN_*: Idempotent first-admin seed at startup. When FIRST_ADMIN_PASSWORD
#   is set, the user is created or updated with that password. Seed skipped if
#   password unset (fail-open). Only the first admin is env-seeded; further users
#   require operator/SQL migration.
#   Login is fail-closed: with no seeded user, /api/v1/auth/token returns 401.
FIRST_ADMIN_USERNAME=operator
FIRST_ADMIN_EMAIL=operator@example.com
#
# FIRST_ADMIN_PASSWORD: Plaintext password (a real secret). Do not commit.
#   Local dev: set in .env (gitignored)
#   Production: Phase 2+ can inject via FIRST_ADMIN_PASSWORD_FILE (mounted from
#     Secret Manager) so plaintext never lands in shell history/process listings.
FIRST_ADMIN_PASSWORD=
#
# FIRST_ADMIN_PASSWORD_FILE: Alternative to FIRST_ADMIN_PASSWORD; path to a file
#   containing the plaintext password. Mounted from Secret Manager in production.
#   When both are set, _FILE takes precedence.
FIRST_ADMIN_PASSWORD_FILE=
#
# ACCESS_TOKEN_TTL_MINUTES: Lifetime of access tokens (minutes). Expiry is checked
#   on each request; expired tokens return 401.
ACCESS_TOKEN_TTL_MINUTES=10
#
# REFRESH_TOKEN_TTL_DAYS: Lifetime of refresh tokens (days). Refresh tokens rotate
#   on every use with family reuse-detection (same session family, prior tokens are
#   invalidated after the new one is issued).
REFRESH_TOKEN_TTL_DAYS=30

# --- Skill bank + tailored revisions (POST /cv/tailor, MCP match_jd) ---
# CV_BASELINE_PATH: Path to skill bank JSON (separate from live CV). Lazy-loaded on
#   first use and memoized per file mtime; editing the file while the server runs
#   picks up the change on the next /cv/tailor call. Used by POST /cv/tailor and
#   MCP match_jd tool for job description matching.
CV_BASELINE_PATH=data/cv_baseline.json
#
# CV_TAILORED_DIR: Directory that receives cv_tailored-<UTC-timestamp>.json revision
#   files. The operator reviews and promotes revisions to the public CV
#   (never auto-overwrites).
CV_TAILORED_DIR=data/tailored
