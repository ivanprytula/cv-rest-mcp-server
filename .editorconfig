# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python — mirrors Ruff config in pyproject.toml ([tool.ruff] line-length)
[*.py]
indent_style = space
indent_size = 4
max_line_length = 88

[*.html]
indent_style = space
indent_size = 4

[*.{js,mjs,cjs}]
indent_style = space
indent_size = 2

[*.css]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

# Markdown — trailing whitespace can be significant (two spaces = hard break)
[*.md]
trim_trailing_whitespace = false
