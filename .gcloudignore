# gcloud builds submit uses this file verbatim (it does NOT merge .gitignore).
# config/ must stay included (geo blocklist is baked into the image).
# data/: only cv.example.json goes to the build (placeholder fallback);
# real cv.json is personal data delivered from GCS at runtime.
# Skill bank is operator-curated, not personal data; ship in the image.
.git/
.github/
.venv/
venv/
__pycache__/
*.pyc
*.md
tests/
*.egg-info
.pytest_cache/
.ruff_cache/
.pre-commit-cache/
.agents/
.kilo/
.learnings/
.local/
.remember/
.vscode/

node_modules/
dist/
build/
.env
data/*
!data/cv.example.json
!data/cv_baseline.json
.dockerignore
.gcloudignore
justfile

.agents/
.agent/
.github/prompts/
