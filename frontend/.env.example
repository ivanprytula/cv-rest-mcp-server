# Local dev only — Vite bakes VITE_* into the JS bundle at build time, so
# nothing here reaches the deployed SPA. Production is set via the
# PORTFOLIO_BASE_URL GitHub Actions variable, passed as a Docker --build-arg
# in deploy-app.yml and re-exposed to Vite under this VITE_ name (see
# frontend/Dockerfile).
VITE_API_BASE_URL=http://localhost:8080
